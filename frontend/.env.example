# Public browser configuration. Never place server secrets in VITE_ variables.
# Relative /api uses the Vite proxy when mocking is disabled.
VITE_API_BASE_URL=/api

# Opt-in browser mocks; only honoured by the Vite development server.
# Copy this file to .env.local to enable. Without it, requests use the real API.
VITE_ENABLE_MOCKS=true

# With mocks enabled, simulate only route calculation; use C# for other APIs.
VITE_USE_REAL_BACKEND=false
# Optional Vite development proxy target (default: http://localhost:5000).
ROUTEWISE_API_PROXY_TARGET=http://localhost:5000

# Enable Maps JavaScript API and Places API (New) in your Google Cloud project.
# Restrict the browser key by HTTP referrer and allowed Google APIs.
VITE_GOOGLE_MAPS_API_KEY=

# JavaScript Map ID for Advanced Markers. Required in production.
# Development only: when blank, DEMO_MAP_ID is used.
VITE_GOOGLE_MAP_ID=
