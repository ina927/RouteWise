# Public browser configuration. Never place server secrets in VITE_ variables.
# Relative /api uses the Vite development proxy; Phase 2 will consume this value.
VITE_API_BASE_URL=/api

# Reserved for later Maps integration. Leave blank during Phase 0.
# A future browser key must be restricted by HTTP referrer and allowed Google APIs.
VITE_GOOGLE_MAPS_API_KEY=
